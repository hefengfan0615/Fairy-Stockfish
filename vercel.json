{
  "buildCommand": "cp tests/js/ffish.js web/ffish.js && cp tests/js/ffish.wasm web/ffish.wasm && cp tests/js/ffish.data web/ffish.data 2>/dev/null; cp src/minixiangqi.nnue web/minixiangqi.nnue 2>/dev/null; echo 'Build complete'",
  "outputDirectory": "web",
  "installCommand": "",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/(.*)\\.data",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ]
}